# ---- General -------------------------------------------------------------
# Long random string; required so sessions survive restarts.
SECRET_KEY=change-me-to-a-long-random-string
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

# ---- Data source ---------------------------------------------------------
# true = generate fake data locally (no Azure access needed)
MOCK_MODE=true
MOCK_SEED=42

# App Registration used to read Activity Logs + Resource Graph
# (needs Reader / Monitoring Reader on the scopes you want to see)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Use Resource Graph `resourcechanges` for before/after values (last 14 days)
USE_RESOURCE_GRAPH_CHANGES=true

# Subscriptions excluded by default: IDs or glob patterns on subscription name
DEFAULT_EXCLUDED_SUBSCRIPTIONS=*sandbox*,*sbx*,*preprod*,*pre-prod*

# Client IDs of the Terraform Enterprise service principals (comma separated).
# In MOCK_MODE this defaults to the mock TFE IDs when left blank.
TFE_CLIENT_IDS=
TFE_FILTER_DEFAULT=true

CLICKOPS_TOP_N=10
MAX_LOOKBACK_DAYS=90
CACHE_TTL_SECONDS=300
FETCH_CONCURRENCY=8

# ---- Local admin ----------------------------------------------------------
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=admin
# Preferred: a werkzeug password hash (see README). Remember to escape $ as $$ in compose files.
LOCAL_ADMIN_PASSWORD_HASH=
# Plain-text alternative (MOCK_MODE defaults this to "admin" if both are blank)
LOCAL_ADMIN_PASSWORD=

# ---- Entra ID sign-in ------------------------------------------------------
ENTRA_AUTH_ENABLED=false
# Default to the AZURE_* values above if not set
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Set when behind a proxy that changes the host, e.g. https://delta.contoso.com/auth/callback
ENTRA_REDIRECT_URI=
# Optional access restriction (object IDs of groups and/or app role values)
ENTRA_ALLOWED_GROUPS=
ENTRA_ALLOWED_ROLES=
